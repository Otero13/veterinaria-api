# Copiar este archivo a ".env" y completar los valores. NUNCA subir ".env" al repositorio.

# Clave secreta de Django (generar una nueva, ver README)
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# True solo en desarrollo local
DJANGO_DEBUG=True
# Hosts permitidos separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes permitidos por CORS (frontend) separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Orígenes confiables para CSRF (solo necesario en producción, ej: https://miapp.onrender.com)
CSRF_TRUSTED_ORIGINS=

# Límites de peticiones (rate limiting)
THROTTLE_ANON=30/min
THROTTLE_USER=120/min
THROTTLE_LOGIN=5/min
THROTTLE_REGISTRO=3/min
